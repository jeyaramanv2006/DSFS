# PC A (Coordinator / Host Machine)
# Replace <PC_B_LAN_IP> and <PC_C_LAN_IP> with the actual LAN IP addresses of storage nodes.
# Generate a secure cluster secret (e.g. openssl rand -hex 32) and use the identical value across all three PCs.

HOST=0.0.0.0
PORT=8080
DB_PATH=./data/api.db
STORAGE_NODES=node-1=http://<PC_B_LAN_IP>:9001,node-2=http://<PC_C_LAN_IP>:9001
STORAGE_CLUSTER_SECRET=replace_with_long_random_cluster_secret_shared_across_all_pcs
LOG_LEVEL=info

# Monitor and background intervals (in milliseconds)
HEALTH_MONITOR_INTERVAL_MS=2000
HEARTBEAT_UNHEALTHY_MS=6000
HEARTBEAT_UNAVAILABLE_MS=12000
CLEANUP_INTERVAL_MS=20000
RECONCILE_INTERVAL_MS=30000
